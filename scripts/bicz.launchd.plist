<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: replace @HOME@ with your home directory (docs/SETUP.md, "Run at login (macOS)"). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.bicz.supervisor</string>
  <key>ProgramArguments</key>
  <array>
    <string>@HOME@/.local/bin/bicz</string>
    <string>serve</string>
    <string>--db</string>
    <string>@HOME@/.bicz/ledger.sqlite</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BICZ_RUNTIME_DIR</key>
    <string>@HOME@/.bicz/run</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>@HOME@/.bicz/serve.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/.bicz/serve.log</string>
</dict>
</plist>
